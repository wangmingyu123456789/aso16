+            "sender_id": assistant_uid,
+            "sender_name": "天气查询",
+            "msg_type": db_msg_type,
+            "content": content,
+            "create_at": now
+        }
+
+        # 推送给会话中所有在线成员
+        for m in members:
+            if m["id"] in connection_pool:
+                for conn in connection_pool[m["id"]]:
+                    try:
+                        conn.write_message(json.dumps(msg_obj))
+                    except Exception:
