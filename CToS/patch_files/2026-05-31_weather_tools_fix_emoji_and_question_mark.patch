+def _strip_emoji(text: str) -> str:
+    """移除字符串中的所有 emoji 字符，避免 Pillow 渲染方块字符"""
+    emoji_pattern = re.compile(
+        "[\U0001F300-\U0001F9FF"   # 杂项符号和 pictograph
+        "\U0001FA00-\U0001FA6F"    # 象棋符号等
+        "\U0001FA70-\U0001FAFF"    # 符号和 pictograph 扩展-A
+        "\U00002702-\U000027B0"    # 丁贝符号
+        "\U000024C2-\U0001F251"    # 带括号的字母等
+        "\U0001F004-\U0001F0CF"    # 游戏符号等
+        "\U0001F18E-\U0001F1FF"    # 注册商标等
+        "\U00002100-\U000027BF"    # 字母符号等
+        "\U0001F200-\U0001F2FF"    # 补充符号
+        "\U00002600-\U000026FF"    # 杂项符号
+        "\U00002900-\U0000297F"    # 补充箭头-B
+        "\U00002B00-\U00002BFF"    # 杂项符号和箭头
+        "\U0001F600-\U0001F64F"    # 表情符号
+        "\U0001F680-\U0001F6FF"    # 交通和地图符号
+        "\U0001F780-\U0001F7FF"    # 几何形状扩展
+        "\U0000FE00-\U0000FE0F"    # 变体选择器
+        "\U0000200D"               # 零宽连字符
+        "\U0000FE0F]"              # VS16 变体选择器
+    )
+    return emoji_pattern.sub('', text).strip()
+
