# ===========================================================================
# CToS2 系统环境变量配置
#
#              ┌──────────────┐     ┌──────────────┐     ┌──────────────┐
#              │  后端实例1   │     │  后端实例2   │     │  后端实例3   │
#              │ (端口 8001)  │     │ (端口 8002)  │     │ (端口 8003)  │
#              └──────┬───────┘     └──────┬───────┘     └──────┬───────┘
#                     │                    │                    │
#                     └────────────────────┼────────────────────┘
#                                          │
#                                  ┌───────┴────────┐
#                                  │  MySQL 数据库   │ ← 独立服务
#                                  │  (端口 3306)    │
#                                  └────────────────┘
#
# 数据库配置
#   ACTIVE_DATABASE = mysql | sqlite   （推荐使用 mysql）
#   
#   【MySQL】（默认推荐——支持多后端实例共享）
#   MYSQL_HOST = localhost
#   MYSQL_PORT = 3306
#   MYSQL_USER = ctos
#   MYSQL_PASSWORD = ctos123
#   MYSQL_DATABASE = ctos
#   
#   【SQLite】（单实例开发模式）
#   SQLITE_PATH = ./data/ctos.db
# ===========================================================================

# ===== 数据库配置 =====
# 当前使用的数据库类型: mysql / sqlite
# 【推荐】使用 MySQL 作为独立数据库服务，支持多后端实例横向扩展
ACTIVE_DATABASE = sqlite

# SQLite 配置（仅单实例开发时使用）
SQLITE_PATH = ./data/ctos.db

# MySQL 配置
#   docker-compose up -d   # 一键启动 MySQL 服务
#   python database/db_service_init.py  # 初始化数据库表和数据
MYSQL_HOST = localhost
MYSQL_PORT = 3306
MYSQL_USER = root
MYSQL_PASSWORD = 
MYSQL_DATABASE = ctos

# ===== JWT 配置 =====
JWT_SECRET_KEY = ctos-jwt-secret-key
JWT_ALGORITHM = HS256
JWT_EXPIRATION_HOURS = 24

# ===== 应用配置 =====
ENV = development
CORS_ORIGINS = *
APP_PORT = 8000
MAX_FILE_SIZE = 10485760
SYSTEM_NAME = CToS智能系统