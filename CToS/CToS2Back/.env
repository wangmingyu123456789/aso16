# ===========================================================================
# CToS2 系统环境变量配置
# ===========================================================================

# ===== 数据库配置 =====
ACTIVE_DATABASE = sqlite
SQLITE_PATH = ./data/ctos.db

# MySQL 配置
MYSQL_HOST = localhost
MYSQL_PORT = 3306
MYSQL_USER = root
MYSQL_PASSWORD = 
MYSQL_DATABASE = ctos

# ===== JWT 配置 =====
JWT_SECRET_KEY = ctos-jwt-secret-key
JWT_ALGORITHM = HS256
JWT_EXPIRATION_HOURS = 24

# ===== 应用配置 =====
ENV = development
CORS_ORIGINS = *
APP_PORT = 8000
MAX_FILE_SIZE = 10485760
SYSTEM_NAME = CToS智能系统

# ===== 外部服务配置 =====
EXTERNAL_PORT = 9877
EXTERNAL_BASE_URL = http://localhost:9877
SYSTEM_BASE_URL = http://localhost:8000
